        <section className='section section--soft'>
          <div className='container reading-column'>
            <h2>Common Inquiries & Quick Links</h2>
            <div className='quick-links-grid'>
              <article className='quick-link-card'>
                <h3>Deploy in Your Constituency</h3>
                <p>Request a demo, discuss partnership terms, or get technical specifications for MP office integration.</p>
                <Link to='/contact' className='text-link' onClick={() => handleCTAClick('deployment_inquiry')}>Request Deployment →</Link>
              </article>
              <article className='quick-link-card'>
                <h3>Report a Constituency Issue</h3>
                <p>Test the citizen portal — submit a grievance and track it with a Reference ID. No account needed.</p>
                <Link to='/report-issue' className='text-link' onClick={() => handleCTAClick('try_reporting')}>Try Reporting →</Link>
              </article>
              <article className='quick-link-card'>
                <h3>Read the Methodology</h3>
                <p>Full 40-40-20 scoring formulas, dataset mappings, severity rubric, and safeguards.</p>
                <Link to='/methodology' className='text-link' onClick={() => handleCTAClick('view_methodology')}>View Methodology →</Link>
              </article>
              <article className='quick-link-card'>
                <h3>API & Technical Docs</h3>
                <p>REST endpoints, webhook formats, authentication, rate limits, and integration guides.</p>
                <Link to='/contact' className='text-link' onClick={() => handleCTAClick('technical_docs')}>Request API Access →</Link>
              </article>
              <article className='quick-link-card'>
                <h3>Data Rights & Privacy</h3>
                <p>Exercise your rights under DPDP Act 2023 / GDPR: access, rectification, erasure, portability.</p>
                <Link to='/privacy' className='text-link' onClick={() => handleCTAClick('privacy_rights')}>View Privacy Notice →</Link>
              </article>
              <article className='quick-link-card'>
                <h3>Accessibility Feedback</h3>
                <p>Report barriers, suggest improvements, or participate in user testing with assistive technology.</p>
                <Link to='/accessibility' className='text-link' onClick={() => handleCTAClick('accessibility_feedback')}>View Statement →</Link>
              </article>
            </div>
          </div>
        </section>

        <section className='section section--navy' aria-labelledby='cta-heading'>
          <div className='container cta-card'>
            <div>
              <h2 id='cta-heading'>Ready to Deploy Evidence-Based Prioritization?</h2>
              <p>Join MP offices using transparent, data-backed planning for faster, fairer development decisions.</p>
            </div>
            <div className='hero__actions'>
              <Link to='/contact' className='button button--light' onClick={() => handleCTAClick('deployment_inquiry')}>
                Start Deployment Conversation
              </Link>
              <Link to='/report-issue' className='button button--ghost' onClick={() => handleCTAClick('try_platform')}>
                Test the Platform
              </Link>
            </div>
          </div>
        </section>
