const CATEGORY_ICONS = {
  roads: '🛣️', water: '💧', health: '🏥', education: '📚', power: '⚡', housing: '🏠',
  agri: '🌾', employment: '💼', safety: '🛡️', environment: '🌿', transport: '🚌', other: '📋',
};

export default function ConstituencyDetail() {
  const { slug } = useParams();
  const constituency = CONSTITUENCY_DATA[slug] || CONSTITUENCY_DATA['visakhapatnam'];
  const SITE_URL = 'https://samadhan-chi.vercel.app';

  const breadcrumbs = [
    { name: 'Home', url: SITE_URL },
    { name: 'Constituencies', url: SITE_URL + '/constituencies' },
    { name: constituency.name, url: SITE_URL + `/constituency/${slug}` },
  ];

  return (
    <>
      <SEO
        title={`${constituency.name} Constituency Dashboard | Samadhan`}
        description={`Constituency dashboard for ${constituency.name}, ${constituency.state}: ${constituency.metrics.totalReports} citizen reports, ${constituency.metrics.activeProjects} active projects, ${constituency.metrics.completedProjects} completed. Real-time heatmaps, AI-assisted prioritization, evidence-backed recommendations.`}
        path={`/constituency/${slug}`}
        pageType="constituencyDetail"
      />
      <div className='page-shell'>
        <Header />
        <main>
          <Breadcrumb className='container' breadcrumbs={breadcrumbs} />
          
          {/* Hero */}
          <section className='page-hero'>
            <div className='container page-hero__inner'>
              <p className='eyebrow'>Parliamentary Constituency Dashboard</p>
              <h1>{constituency.name}, {constituency.state}</h1>
              <p className='hero__lead'>
                <strong>MP: {constituency.mpName}</strong> | 
                Population: {constituency.population} | 
                Area: {constituency.area} | 
                Districts: {constituency.districts.join(', ')}
              </p>
            </div>
          </section>

          {/* Key Metrics */}
          <section className='section section--soft'>
            <div className='container metrics-grid'>
              <div className='metric-card'>
                <span className='metric-value'>{constituency.metrics.totalReports}</span>
                <span className='metric-label'>Citizen Reports (All Time)</span>
              </div>
              <div className='metric-card'>
                <span className='metric-value'>{constituency.metrics.activeProjects}</span>
                <span className='metric-label'>Active Projects in Pipeline</span>
              </div>
              <div className='metric-card'>
                <span className='metric-value'>{constituency.metrics.completedProjects}</span>
                <span className='metric-label'>Projects Completed</span>
              </div>
              <div className='metric-card'>
                <span className='metric-value'>{constituency.metrics.avgScore}</span>
                <span className='metric-label'>Avg Priority Score</span>
              </div>
            </div>
          </section>

          {/* Heatmap + Category Breakdown */}
          <section className='section'>
            <div className='container'>
              <div className='dashboard-grid'>
                <div className='dashboard-main'>
                  <h2>Grievance Heatmap</h2>
                  <div className='heatmap-placeholder' style={{ aspectRatio: '16/9', background: '#f1f5f9', borderRadius: '12px', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#64748b' }}>
                    Interactive Mapbox/Leaflet heatmap — village/ward density with category filter & time slider
                  </div>
                  <div className='heatmap-controls'>
                    <label>Category: 
                      <select className='input-select'>
                        <option>All Categories</option>
                        {Object.keys(CATEGORY_ICONS).map(c => <option key={c} value={c}>{c}</option>)}
                      </select>
                    </label>
                    <label>Time Range: 
                      <select className='input-select'>
                        <option>Last 30 days</option>
                        <option>Last 90 days</option>
                        <option>Last 180 days</option>
                        <option>All time</option>
                      </select>
                    </label>
                  </div>
                </div>

                <div className='dashboard-sidebar'>
                  <div className='sidebar-card'>
                    <h3>Category Breakdown</h3>
                    <ul className='category-list'>
                      {constituency.metrics.topCategories.map((cat, i) => (
                        <li key={cat} className='category-item'>
                          <span className='category-icon'>{CATEGORY_ICONS[cat.toLowerCase()] || '📋'}</span>
                          <span className='category-name'>{cat}</span>
                          <span className='category-count'>{(constituency.metrics.totalReports * (0.4 - i * 0.08)).toFixed(0)} reports</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div className='sidebar-card'>
                    <h3>Top Priority Projects</h3>
                    <ul className='project-list'>
                      {constituency.recentProjects.map((project, i) => (
                        <li key={i} className='project-item'>
                          <div className='project-info'>
                            <strong>{project.name}</strong>
                            <span className='project-category'>{project.category}</span>
                          </div>
                          <div className='project-score'>
                            <span className='score-badge'>{project.score}/100</span>
                            <span className={`status-badge status-${project.status.toLowerCase().replace(' ', '-')}`}>{project.status}</span>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </section>

          {/* Key Issues */}
          <section className='section section--alt'>
            <div className='container reading-column'>
              <h2>Key Infrastructure Challenges</h2>
              <p>Based on citizen reports, public dataset gaps, and MP office priorities for {constituency.name}:</p>
              <ul className='issues-grid'>
                {constituency.keyIssues.map((issue, i) => (
                  <li key={i} className='issue-card'>
                    <span className='issue-number'>{i + 1}</span>
                    <p>{issue}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>

          {/* How It Works Locally */}
          <section className='section'>
            <div className='container reading-column'>
              <h2>How {constituency.name} Dashboard Works</h2>
              <p>Every constituency dashboard runs the same transparent 40-40-20 scoring pipeline with local data:</p>
              <ol>
                <li><strong>Local Intake:</strong> Citizens in {constituency.name} report via web, WhatsApp, voice, or meetings in English, Hindi, and {constituency.state === 'Andhra Pradesh' || constituency.state === 'Telangana' ? 'Telugu' : constituency.state === 'Tamil Nadu' ? 'Tamil' : constituency.state === 'Karnataka' ? 'Kannada' : constituency.state === 'Maharashtra' ? 'Marathi' : constituency.state === 'West Bengal' ? 'Bengali' : 'the local language'}.</li>
                <li><strong>Local Evidence:</strong> Grievances matched to datasets at village/ward level within {constituency.districts.join(', ')} districts — Census 2011 amenities, NFHS-5 health readiness, UDISE+ school infra, PMGSY roads, JJM water, Saubhagya power, PMAY-G housing.</li>
                <li><strong>Local Scoring:</strong> 40-40-20 model produces constituency-specific rankings. Demand normalized against {constituency.name}'s own category maximums. Deficit from local dataset values.</li>
                <li><strong>Local Review:</strong> {constituency.mpName}'s office accesses secure dashboard to verify evidence, override scores with justification, and generate sanction notes aligned with MPLADS/state schemes.</li>
              </ol>
            </div>
          </section>

          {/* CTA */}
          <section className='section section--navy' aria-labelledby='cta-heading'>
            <div className='container cta-card'>
              <div>
                <h2 id='cta-heading'>MP Office: Access {constituency.name} Dashboard</h2>
                <p>Secure login for {constituency.mpName}'s office to review ranked projects, verify evidence, and prepare sanction notes.</p>
              </div>
              <div className='hero__actions'>
                <Link to='/mp/login' className='button button--light' onClick={() => trackCTAClick('mp_login_constituency')}>
                  MP Office Login
                </Link>
                <Link to='/contact' className='button button--ghost' onClick={() => trackCTAClick('contact_constituency')}>
                  Deployment Inquiry
                </Link>
              </div>
            </div>
          </section>
        </main>
        <Footer />
      </div>
    </>
  );
}