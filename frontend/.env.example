VITE_SITE_URL=https://samadhan-chi.vercel.app
VITE_API_URL=

# Analytics: Google Tag Manager container GTM-NQ6GK9QG is loaded from
# index.html. Configure the GA4 property inside the GTM UI
# (Google Analytics > Configuration), not here.
#
# VITE_GA4_MEASUREMENT_ID is only needed if the project ever runs GA4
# directly instead of through GTM. Setting it while GTM is also installed
# causes duplicate page_view events.
VITE_GA4_MEASUREMENT_ID=